# ========================================================
# LaunchLog - Botchain Mainnet Environment Variables
# ========================================================

# Botchain Mainnet RPC URL
RPC_URL=https://rpc.botchain.ai

# Deployer wallet private key (used by Hardhat for contract deployment)
PRIVATE_KEY=your_private_key_here

# Deployed LaunchLog Smart Contract Address
NEXT_PUBLIC_CONTRACT_ADDRESS=0xE00857F9e625ec7D7272febc750C7391cfeC7f6F

# Botchain Mainnet Chain Configuration
NEXT_PUBLIC_CHAIN_ID=677
NEXT_PUBLIC_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_BLOCK_EXPLORER=https://scan.botchain.ai
